# ============================================
# SupportOps AI - Environment Configuration
# ============================================
# Copy this file to .env and fill in the values
# Required variables are marked with [REQUIRED]
# ============================================

# [REQUIRED] PostgreSQL connection string
DATABASE_URL=""

# Required for Docker Compose only. Use a URL-safe password.
POSTGRES_PASSWORD=""

# [REQUIRED] Secret key for JWT token signing (use a random 32+ char string)
JWT_SECRET=""

# [REQUIRED] App URL (used for callbacks and webhooks)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- AI Provider ----
# Optional server-side fallback for OpenRouter
OPENROUTER_API_KEY=""
# Optional OpenAI key when there is no key saved in Settings
OPENAI_API_KEY=""

# ---- SMS (Twilio) ----
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ---- Webhook Security ----
# Secret key for HMAC-SHA256 webhook payload signatures
WEBHOOK_SECRET=""

# ---- CORS (optional) ----
# Set to allow cross-origin API access (e.g., "https://your-frontend.com")
CORS_ORIGIN=""
